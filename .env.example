# ---------------------------------------------------------------------------
# Firebase web SDK — safe to expose. Used for Auth sign-in and httpsCallable,
# by both the admin console and the partner portal.
# Firebase console → Project settings → General → Your apps → Web app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pill-reminder-e8f19.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pill-reminder-e8f19
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pill-reminder-e8f19.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK service account — SECRET. Never prefix these with
# NEXT_PUBLIC_. On Vercel add them as Environment Variables and nowhere else.
# Firebase console → Project settings → Service accounts → Generate new private key
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=pill-reminder-e8f19
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including the BEGIN/END lines. Escaped \n is handled.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Partner portal. Partners sign in with a username, which is turned into
# <username>@<this domain> internally. That address is NOT a mailbox — no mail
# is ever sent to it and there is no password reset. This must match the
# backend's REFERRAL_PARTNER_LOGIN_DOMAIN exactly, or partners cannot sign in.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PARTNER_LOGIN_DOMAIN=partners.med-bell.com
